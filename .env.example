# Скопируй в .env для локального запуска. Сам .env в git не попадает.
# На Railway те же переменные задаются во вкладке Variables сервиса.

# ---------- Telegram ----------
# Токен от @BotFather. Для локальной разработки заведи отдельного dev-бота.
BOT_TOKEN=
# Username бота без @. Можно не задавать: бот узнает его сам через getMe.
BOT_USERNAME=
# Публичный адрес сервиса, например https://bc2regbot-production.up.railway.app
# Пусто → бот работает через polling (только для локальной разработки).
WEBHOOK_BASE_URL=
# Путь webhook (обычно менять не нужно).
WEBHOOK_PATH=/tg/webhook
# Случайная строка (A-Z, a-z, 0-9, _ и -, до 256 символов). Telegram присылает её
# в заголовке X-Telegram-Bot-Api-Secret-Token, чужие запросы отбрасываются.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Порт HTTP-сервера. Railway задаёт PORT сам.
PORT=8080

# ---------- Хранилища ----------
# На Railway: ${{Postgres.DATABASE_URL}} и ${{Redis.REDIS_URL}}.
DATABASE_URL=postgresql://postgres:@127.0.0.1:54444/bc_dev
REDIS_URL=redis://localhost:6379/0

# ---------- Люди и чаты ----------
# Telegram ID суперадминов через запятую (узнать свой ID: @userinfobot).
SUPERADMIN_IDS=
# ID чата организаторов (обычно отрицательный, -100...). Бот должен быть добавлен в чат.
# Сюда приходят вопросы участников, ошибки, подозрительные события и отчёты.
ADMIN_CHAT_ID=
# Контакт организаторов, который бот показывает в отказах и в разделе «Контакты».
ORGANIZER_CONTACT=@businesscup_support

# ---------- Поведение ----------
TIMEZONE=Asia/Almaty
# true → рассылки уходят только админам (для репетиций).
TEST_MODE=false
LOG_LEVEL=INFO
# false → человекочитаемые логи в консоли вместо JSON.
LOG_JSON=true
# Одинаковые ошибки алертятся в чат организаторов не чаще, чем раз в N секунд.
ERROR_ALERT_THROTTLE_SECONDS=300

# ---------- Google Sheets: импорт и обратная запись (этап 2) ----------
# Пока SHEET_ID пуст, импорт идёт из CSV (/import с файлом), выгрузка — файлом (/export).
# ID таблицы — часть ссылки между /d/ и /edit.
SHEET_ID=
# JSON-ключ сервис-аккаунта Google целиком, одной строкой (или base64 от файла).
# Таблицу нужно расшарить на client_email из этого ключа (права «Редактор»).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Лист с заявками; пусто → первый лист.
SHEET_APPLICATIONS_WORKSHEET=
# Вкладка со всеми прошедшими (создаётся сама). Рядом бот ведёт вкладки «Чекин <день>» —
# по одной на каждый день мероприятия. Лист заявок (кандидатов) бот только читает.
SHEET_STATUS_WORKSHEET=Прошли
# Отдельный лист с командами "team_name, email"; пусто → не читаем.
SHEET_TEAMS_WORKSHEET=
# Если названия колонок отличаются от формы — JSON {"поле": "колонка"}. Поля:
# participation_type, full_name, email, phone, tg_username_form, linkedin, university,
# year_of_study, major, zimran_interest, career_interest, aiesec_project.
# Пример: SHEET_COLUMN_MAP={"full_name": "ФИО", "phone": "Номер телефона"}
# SHEET_COLUMN_MAP=
# Колонка-флаг отбора. Если её нет, бот ищет «Состояние» / «Статус» (как в таблице кандидатов).
# Отобранным считается значение из SHEET_SELECTED_VALUES или начинающееся с него («Прошёл отбор» ← «прошел»).
SHEET_SELECTED_COLUMN=Selected
SHEET_SELECTED_VALUES=yes,да,1,true,+,✅,selected,accepted,approved,прошел,прошла,прошли,принят,принята,одобрен,одобрена,отобран,отобрана
# Колонка команды. Если её нет, бот ищет «Team name» / «Команда». Пусто в строке → участник пока соло.
SHEET_TEAM_COLUMN=Team
# Как часто обновлять вкладки «Прошли» и «Чекин …» и (если включён) делать автоимпорт.
SHEET_SYNC_MINUTES=2
AUTO_IMPORT_MINUTES=30
SHEETS_TIMEOUT_SECONDS=30

# ---------- Чекин и веб-страницы (этап 7) ----------
# Дни мероприятия (JSON, местное время). Создаются при старте, если их нет; дальше — командой /day.
# EVENT_DAYS=[{"date":"2026-11-14","label":"День 1","opens":"08:00","closes":"13:00"},{"date":"2026-11-15","label":"День 2","opens":"08:00","closes":"13:00"}]
# Секрет для HMAC-кодов меняющегося QR. Сменить = все старые QR сразу недействительны.
CHECKIN_SECRET=
# Ключ в ссылке экрана чекина: /checkin-screen?key=...
SCREEN_SECRET=
# Ключ в ссылке дашборда: /dashboard?key=...
DASHBOARD_SECRET=

# ---------- Интеграция с ботом игр (этап 8) ----------
# Bearer-токен, с которым бот игр вызывает /api/participant-status.
INTEGRATION_TOKEN=
# Куда слать события о привязке и чекинах, например http://bchbot.railway.internal:8080/bc-events
GAMIFICATION_WEBHOOK_URL=
# Секрет HMAC-подписи этих событий (такой же задаётся в боте игр).
GAMIFICATION_WEBHOOK_SECRET=
# Username бота игр без @ — для кнопок «Игры» и «Открыть бинго».
GAMES_BOT_USERNAME=
# Ссылка-приглашение в общий чат фотоханта.
GAMES_CHAT_LINK=
